-  void lowerIntrinsicToFunction(IntrinsicInst *Intrinsic);
+  void lowerIntrinsicToFunction(llvm::IntrinsicInst *Intrinsic);
 
   /// No SPIR-V counterpart for @llvm.fshl.*(@llvm.fshr.*) intrinsic. It will be
