-  ret i32 0, !dbg !25
+  call void @llvm.dbg.declare(metadata %class.C* %1, metadata !14, metadata !DIExpression()), !dbg !22
+  ret i32 0, !dbg !23
 }
 
-; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
