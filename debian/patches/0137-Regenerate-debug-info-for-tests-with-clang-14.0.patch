Subject: [PATCH 137/172] Regenerate debug info for tests with clang 14.0

---
 test/DebugInfo/DebugInfoTypeBasic.ll       | 36 ++++++-------
 test/DebugInfo/DebugInfoTypeInheritance.ll | 60 +++++++++++-----------
 2 files changed, 46 insertions(+), 50 deletions(-)

diff --git a/test/DebugInfo/DebugInfoTypeBasic.ll b/test/DebugInfo/DebugInfoTypeBasic.ll
index 4ad5fa59..fc9010e2 100644
--- a/test/DebugInfo/DebugInfoTypeBasic.ll
+++ b/test/DebugInfo/DebugInfoTypeBasic.ll
@@ -9,13 +9,13 @@
 ; RUN: llvm-as %s -o %t.bc
