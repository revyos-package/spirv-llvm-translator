 lib/SPIRV/libSPIRV/spirv_internal.hpp | 18 +++++++++++++++++-
 spirv-headers-tag.conf                |  2 +-
 11 files changed, 54 insertions(+), 35 deletions(-)

diff --git a/lib/SPIRV/SPIRVReader.cpp b/lib/SPIRV/SPIRVReader.cpp
