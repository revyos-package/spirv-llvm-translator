 ; Function Attrs: convergent nounwind
-define spir_func void @bar(%struct.B* noalias sret(%struct.B*) %agg.result) #0 {
+define spir_func void @bar(%struct.B* noalias sret(%struct.B) %agg.result) #0 {
 entry:
   %a = alloca %struct.A, align 8
   %0 = bitcast %struct.A* %a to i8*
